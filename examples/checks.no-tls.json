{
  "version": 1,
  "monitor_interval_seconds": 30,
  "thresholds": {
    "latency_warn_ms": 800,
    "latency_fail_ms": 2500,
    "tls_warn_days": 30,
    "tls_fail_days": 7
  },
  "checks": [
    {
      "id": "loopback-ping",
      "name": "本机回环 / ICMP",
      "group": "本机服务",
      "type": "ping",
      "target": "127.0.0.1",
      "timeout_seconds": 3,
      "tags": ["self", "network"]
    }
  ]
}
