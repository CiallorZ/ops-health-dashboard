{
  "version": 1,
  "thresholds": {
    "latency_warn_ms": 800,
    "latency_fail_ms": 2500,
    "tls_warn_days": 30,
    "tls_fail_days": 7
  },
  "checks": [
    {
      "id": "local-resolver",
      "name": "本机名称解析",
      "group": "本机服务",
      "type": "dns",
      "target": "localhost",
      "timeout_seconds": 3,
      "tags": [
        "self",
        "network"
      ]
    },
    {
      "id": "loopback-ping",
      "name": "本机回环 / ICMP",
      "group": "本机服务",
      "type": "ping",
      "target": "127.0.0.1",
      "timeout_seconds": 3,
      "tags": [
        "self",
        "network"
      ]
    }
  ]
}
