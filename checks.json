{
  "version": 1,
  "thresholds": {
    "latency_warn_ms": 800,
    "latency_fail_ms": 2500,
    "tls_warn_days": 30,
    "tls_fail_days": 7
  },
  "checks": [
    {
      "id": "dashboard-api",
      "name": "看板 API",
      "group": "本机服务",
      "type": "http",
      "target": "http://127.0.0.1:8080/api/health",
      "expected_status": [200],
      "timeout_seconds": 2,
      "tags": ["self", "api"]
    },
    {
      "id": "example-tls",
      "name": "Example TLS",
      "group": "外部依赖",
      "type": "tls",
      "target": "example.com",
      "port": 443,
      "timeout_seconds": 5,
      "tags": ["public", "certificate"]
    },
    {
      "id": "github-web",
      "name": "GitHub Web",
      "group": "外部依赖",
      "type": "http",
      "target": "https://github.com/",
      "expected_status": [200],
      "timeout_seconds": 5,
      "tags": ["public", "api"]
    },
    {
      "id": "public-dns-tcp",
      "name": "Cloudflare DNS / TCP",
      "group": "外部依赖",
      "type": "tcp",
      "target": "1.1.1.1",
      "port": 53,
      "timeout_seconds": 3,
      "tags": ["public", "network"]
    },
    {
      "id": "loopback-ping",
      "name": "本机回环 / ICMP",
      "group": "本机服务",
      "type": "ping",
      "target": "127.0.0.1",
      "timeout_seconds": 3,
      "tags": ["self", "network"]
    }
  ]
}

